/target
# wasm-bindgen output (regenerated by build-web.sh); the web shell is tracked
/web/cowboyadvance.js
/web/cowboyadvance_bg.wasm
/web/cowboyadvance*.d.ts
/web/build_id.txt
.DS_Store

# The unfiltered frame from `cargo run --example painting`; the finished
# renders/painting.png (the README header) is tracked.
/renders/painting_raw.png

# Favicon intermediates from `just favicon`; the cut icons in assets/ui/ and
# web/favicon.ico are tracked.
/renders/favicon.png
/renders/favicon-keyed.png

# Loading-GIF frames from `just loading-gif`; the assembled gif is tracked.
/renders/loading/

# Blender: rolling backups, bytecode from the rigging scripts, and the rigged
# scene (regenerated by blender/build_rig.py; the source .blend is tracked)
*.blend1
blender/
